{
  "name": "affan-accounting-os",
  "version": "1.0.0",
  "private": true,
  "description": "Affan Accounting OS - Personal Accounting System powered by Node.js, Express, SQLite & React",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6"
  }
}
